{
  "expo": {
    "name": "YogaByTheSofa",
    "slug": "framework",
    "scheme": "framework",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yogabythesofa.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.yogabythesofa.app"
    },
    "locales": {
      "en": "./locales/en.json",
      "ro": "./locales/ro.json"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photos to add pictures and videos to your workouts and home page."
        }
      ],
      "expo-video",
      "expo-status-bar",
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#4F7D6B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
