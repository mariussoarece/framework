# Copy to infra/.env, fill in, then append secrets:
#   cp infra/.env.example infra/.env
#   node infra/scripts/gen-keys.mjs >> infra/.env
# Never commit infra/.env.

# --- Your server
DOMAIN=api.example.com            # points to the VPS IP (DNS A record)
SITE_URL=https://example.com      # your website (owner sign-up, password reset)
APP_REDIRECT_URLS=framework://auth-callback,https://example.com/**
MEDIA_ROOT=/srv/media             # uploads/ and published/ live under here
BACKUP_DIR=/srv/backups
BACKUP_REMOTE=                    # e.g. backup@storage.example.com:/backups/framework

# --- Versions (pin; update deliberately)
POSTGRES_DB=app
GOTRUE_VERSION=v2.158.1           # https://hub.docker.com/r/supabase/gotrue/tags
POSTGREST_VERSION=v12.2.3         # https://hub.docker.com/r/postgrest/postgrest/tags
NGINX_VERSION=1.27-alpine
PGADMIN_VERSION=8

# --- Email (login confirmations, password reset, closing notices)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=no-reply@example.com
SMTP_SENDER_NAME=YogaByTheSofa

# --- Social login (fill in when ready)
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_SECRET=

# --- pgAdmin login
PGADMIN_EMAIL=admin@example.com

# --- Secrets: generated by gen-keys.mjs (appended below)
