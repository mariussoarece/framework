# Copy to infra/.env, fill in, then append secrets:
#   cp infra/.env.example infra/.env
#   node infra/scripts/gen-keys.mjs >> infra/.env
# Never commit infra/.env.

# --- Your server
# points to the VPS IP (DNS A record)
DOMAIN=api.example.com
# your website (owner sign-up, password reset)
# Where links in "confirm your email" / "reset your password" emails land:
# the small page in infra/web/index.html, served by this server's nginx.
SITE_URL=https://api.example.com/
APP_REDIRECT_URLS=framework://auth-callback,https://api.example.com/**
# uploads/ and published/ live under here
MEDIA_ROOT=/srv/media
BACKUP_DIR=/srv/backups
# e.g. backup@storage.example.com:/backups/framework
BACKUP_REMOTE=

# --- Web entry point
# standalone:   the app's nginx uses ports 80/443 and gets its own HTTPS certificate
# behind-proxy: the VPS already runs nginx for other sites; that nginx forwards the
#               app's domain to 127.0.0.1:8088 (see infra/nginx/host-site.conf.example)
NGINX_MODE=standalone
NGINX_HTTP_BIND=80
NGINX_HTTPS_BIND=443
# for behind-proxy use:
#   NGINX_MODE=behind-proxy
#   NGINX_HTTP_BIND=127.0.0.1:8088
#   NGINX_HTTPS_BIND=127.0.0.1:8443

# --- Versions (pin; update deliberately)
POSTGRES_DB=app
# https://hub.docker.com/r/supabase/gotrue/tags
GOTRUE_VERSION=v2.158.1
# https://hub.docker.com/r/postgrest/postgrest/tags
POSTGREST_VERSION=v12.2.3
NGINX_VERSION=1.27-alpine
PGADMIN_VERSION=8

# --- Email (login confirmations, password reset, closing notices)
# true = accounts work without clicking the confirmation email (testing only, while SMTP isn't set up)
MAILER_AUTOCONFIRM=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=no-reply@example.com
SMTP_SENDER_NAME=YogaByTheSofa

# --- Social login (fill in when ready)
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_SECRET=

# --- Media limits
MAX_VIDEO_MB=500
MAX_IMAGE_MB=20
# signed video links stay valid 6 hours
MEDIA_LINK_TTL_SECONDS=21600

# --- Stripe (dashboard.stripe.com -> Developers; use test keys first)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# from the webhook endpoint https://<DOMAIN>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_COUNTRY=RO

# --- Push notifications (files go in infra/secrets/)
APNS_KEY_FILE=/run/secrets/AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json

# --- pgAdmin login
PGADMIN_EMAIL=admin@example.com

# --- Secrets: generated by gen-keys.mjs (appended below)
