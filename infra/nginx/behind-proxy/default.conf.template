# Used when the VPS already runs its own nginx on ports 80/443 (NGINX_MODE=behind-proxy).
# The host nginx handles HTTPS for ${DOMAIN} and forwards everything to this container
# on 127.0.0.1:8088 (NGINX_HTTP_BIND). See infra/nginx/host-site.conf.example.

# trust the host nginx's X-Forwarded-For for client IPs
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;

server {
    listen 80;
    server_name ${DOMAIN};

    client_max_body_size 1g;   # video uploads
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    location /auth/v1/ {
        proxy_pass http://auth:9999/;
    }

    location /rest/v1/ {
        proxy_pass http://rest:3000/;
    }

    location /api/ {
        proxy_pass http://api:8080;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Published pictures and videos, signed expiring links (same rules as standalone mode).
    location /media/ {
        secure_link $arg_md5,$arg_expires;
        secure_link_md5 "$secure_link_expires$uri ${MEDIA_LINK_SECRET}";
        if ($secure_link = "")  { return 403; }
        if ($secure_link = "0") { return 410; }

        alias /srv/media/published/;
        types {
            video/mp4  mp4;
            image/jpeg jpg jpeg;
            image/webp webp;
            image/png  png;
        }
        add_header Cache-Control "private, max-age=3600";
    }

    # the page opened from "confirm your email" / "reset your password" emails
    location = / {
        root /usr/share/nginx/web;
        try_files /index.html =404;
        add_header Cache-Control "no-store";
        add_header Referrer-Policy "no-referrer";
        add_header X-Frame-Options "DENY";
    }

    location / {
        return 404;
    }
}
